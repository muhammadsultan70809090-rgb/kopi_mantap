{
  "name": "kopi-mantap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Kopi Mantap - premium coffee shop ordering platform",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0 --port 3000\"",
    "build": "vite build",
    "vercel-build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
